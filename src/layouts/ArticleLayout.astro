---
import BaseLayout from './BaseLayout.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts?: CollectionEntry<'blog'>[];
}

const { post, allPosts = [] } = Astro.props;
const { title, description, pubDate, tags, keyword, afiliados } = post.data;

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags.some((tag) => tags.includes(tag)))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  keywords: keyword,
  datePublished: pubDate.toISOString(),
  inLanguage: 'es',
  publisher: {
    '@type': 'Organization',
    name: 'INMOIA',
    url: Astro.site?.href ?? 'https://inmoia.vercel.app',
  },
};

function extractFaqItems(body: string): { question: string; answer: string }[] {
  const lines = body.split('\n');
  const faqStart = lines.findIndex((line) => /^##\s+.*pregunta/i.test(line));
  if (faqStart === -1) return [];

  const items: { question: string; answer: string }[] = [];
  let current: { question: string; answer: string[] } | null = null;

  for (const line of lines.slice(faqStart + 1)) {
    if (/^##\s+/.test(line)) break; // siguiente sección H2: fin del bloque de FAQ

    const h3Match = line.match(/^###\s+(.+)/);
    if (h3Match) {
      if (current) items.push({ question: current.question, answer: current.answer.join(' ').trim() });
      current = { question: h3Match[1].trim(), answer: [] };
      continue;
    }

    if (current && line.trim() && !line.startsWith('#')) {
      const clean = line
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/\*+([^*]+)\*+/g, '$1')
        .trim();
      if (clean) current.answer.push(clean);
    }
  }
  if (current) items.push({ question: current.question, answer: current.answer.join(' ').trim() });

  return items.filter((item) => item.question && item.answer);
}

const faqItems = extractFaqItems(post.body ?? '');

const faqJsonLd = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8">
      <div class="flex gap-2 flex-wrap mb-3">
        {tags.map((tag) => (
          <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full">{tag}</span>
        ))}
      </div>
      <h1 class="text-3xl font-bold leading-tight mb-3">{title}</h1>
      <p class="text-sm text-gray-500">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {' '}· {readingTime} min de lectura
      </p>
    </header>

    <div class="prose prose-blue max-w-none">
      <slot />
    </div>

    {afiliados.length > 0 && (
      <AffiliateBox herramientas={afiliados} />
    )}
  </article>

  {relatedPosts.length > 0 && (
    <section class="mt-12">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">También te puede interesar</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {relatedPosts.map((related) => (
          <ArticleCard
            title={related.data.title}
            description={related.data.description}
            slug={related.id}
            pubDate={related.data.pubDate}
            tags={related.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}

  <script>
    // Hidrata los placeholders <div class="mi-destacada" data-*> insertados en el
    // markdown de los artículos con el mismo markup/estilos que HerramientaDestacada.astro,
    // ya que los archivos .md no pueden invocar componentes .astro directamente.
    document.querySelectorAll('.mi-destacada[data-nombre]').forEach((el) => {
      const nombre = el.getAttribute('data-nombre') ?? '';
      const descripcion = el.getAttribute('data-descripcion') ?? '';
      const url = el.getAttribute('data-url') ?? '#';
      const cta = el.getAttribute('data-cta') ?? 'Ver más';
      const precio = el.getAttribute('data-precio') ?? '';
      const badge = el.getAttribute('data-badge') ?? '';

      el.className = 'my-8 border-2 border-blue-200 rounded-2xl p-6 bg-gradient-to-r from-blue-50 to-white flex flex-col sm:flex-row gap-4 items-start';
      el.innerHTML = `
        <div class="flex-1">
          ${badge ? `<span class="text-xs font-bold uppercase tracking-wide text-blue-600 bg-blue-100 px-2 py-1 rounded-full mb-2 inline-block">${badge}</span>` : ''}
          <h3 class="text-lg font-bold text-gray-900 mb-1">${nombre}</h3>
          <p class="text-sm text-gray-600 mb-2">${descripcion}</p>
          <p class="text-xs text-gray-400">Desde ${precio}</p>
        </div>
        <div class="shrink-0">
          <a href="${url}" target="_blank" rel="noopener sponsored" class="inline-block bg-blue-700 text-white font-semibold px-5 py-3 rounded-xl hover:bg-blue-800 transition-colors text-sm">${cta} →</a>
        </div>
      `;
    });

    const headings = document.querySelectorAll('article h2');
    if (headings.length > 2) {
      const toc = document.createElement('div');
      toc.className = 'toc my-6 p-4 bg-gray-50 rounded-xl border border-gray-200';
      toc.innerHTML = '<p class="text-sm font-semibold text-gray-700 mb-2">En este artículo</p><ul class="space-y-1">' +
        Array.from(headings).map((h) => {
          const id = (h.textContent ?? '').toLowerCase()
            .replace(/[áàä]/g, 'a').replace(/[éèë]/g, 'e')
            .replace(/[íìï]/g, 'i').replace(/[óòö]/g, 'o')
            .replace(/[úùü]/g, 'u').replace(/ñ/g, 'n')
            .replace(/[^a-z0-9\s]/g, '').replace(/\s+/g, '-');
          h.id = id;
          return `<li><a href="#${id}" class="text-sm text-blue-700 hover:underline">${h.textContent}</a></li>`;
        }).join('') + '</ul>';
      const prose = document.querySelector('.prose');
      if (prose) prose.insertBefore(toc, prose.firstChild);
    }
  </script>
</BaseLayout>
